# Copy to .env (never commit it). Keys are read from .env (or .env.txt) in the
# working directory, or from the real environment.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Model per job, as "provider:model". Providers: openai, openrouter.
# Extraction is the high-volume job, so it gets the cheap model.
OPENPERSONA_EXTRACT_MODEL=openai:gpt-4o-mini
OPENPERSONA_CHAT_MODEL=openrouter:typesafe/jev-router
# Semantic retrieval. Set to "off" to run lexical + graph only.
OPENPERSONA_EMBED_MODEL=openai:text-embedding-3-small

# openpersona serve: required in production. Clients send
# "Authorization: Bearer <key>" (HTTP) or the same metadata (gRPC).
OPENPERSONA_API_KEY=
# Browser origins allowed to call the server, comma-separated (or *).
OPENPERSONA_CORS_ORIGINS=
