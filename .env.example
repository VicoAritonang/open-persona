# Keys are read from .env (or .env.txt) in the working directory, or the real environment.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Persona registry (Postgres; we use Neon). Needed only for push, pull,
# registry and serve -registry. OPENPERSONA_REGISTRY_URL and DATABASE_URL also work.
NEON_DB_URL=
# OPENPERSONA_REGISTRY_SCHEMA=openpersona

# Model per job, as "provider:model". Providers: openai, openrouter.
# Extraction is the high-volume job, so it gets the cheap model.
OPENPERSONA_EXTRACT_MODEL=openai:gpt-4o-mini
OPENPERSONA_CHAT_MODEL=openrouter:typesafe/jev-router
# Semantic retrieval. Set to "off" to run lexical + graph only.
OPENPERSONA_EMBED_MODEL=openai:text-embedding-3-small

# Required in production: clients must send "Authorization: Bearer <key>".
OPENPERSONA_API_KEY=
